digraph G {
  graph [fontname="Helvetica", bgcolor="white", pad=0.3, nodesep=0.45, ranksep=0.9, splines=true, rankdir=RL, label="Modelo relacional normalizado (BCNF)\nPK = clave primaria   FK = clave foranea   UQ = clave candidata (UNIQUE)   GEN = columna generada   La flecha apunta de la FK a la tabla referenciada.\nLos subtipos referencian a activo con la FK compuesta (id_activo, id_tipo_activo).", labelloc=t, fontsize=13];
