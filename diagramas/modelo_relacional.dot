  transaccion [shape=plain, label=<<TABLE BORDER="2" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f3a5f"><TR><TD COLSPAN="3" BGCOLOR="#1f3a5f"><FONT COLOR="white"><B>transaccion</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fff3cd" PORT="id_transaccion_l"><FONT POINT-SIZE="9" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#fff3cd"><B>id_transaccion</B></TD><TD ALIGN="LEFT" BGCOLOR="#fff3cd" PORT="id_transaccion_r"><FONT POINT-SIZE="9" COLOR="#555555">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e3eef9" PORT="id_cuenta_l"><FONT POINT-SIZE="9" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#e3eef9">id_cuenta</TD><TD ALIGN="LEFT" BGCOLOR="#e3eef9" PORT="id_cuenta_r"><FONT POINT-SIZE="9" COLOR="#555555">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e3eef9" PORT="id_activo_l"><FONT POINT-SIZE="9" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#e3eef9">id_activo</TD><TD ALIGN="LEFT" BGCOLOR="#e3eef9" PORT="id_activo_r"><FONT POINT-SIZE="9" COLOR="#555555">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="tipo_transaccion_l"><FONT POINT-SIZE="9" COLOR="#555555"> </FONT></TD><TD ALIGN="LEFT" BGCOLOR="white">tipo_transaccion</TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="tipo_transaccion_r"><FONT POINT-SIZE="9" COLOR="#555555">VARCHAR(10)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="fecha_hora_l"><FONT POINT-SIZE="9" COLOR="#555555"> </FONT></TD><TD ALIGN="LEFT" BGCOLOR="white">fecha_hora</TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="fecha_hora_r"><FONT POINT-SIZE="9" COLOR="#555555">TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="cantidad_l"><FONT POINT-SIZE="9" COLOR="#555555"> </FONT></TD><TD ALIGN="LEFT" BGCOLOR="white">cantidad</TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="cantidad_r"><FONT POINT-SIZE="9" COLOR="#555555">NUMERIC(15,6)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="precio_unitario_l"><FONT POINT-SIZE="9" COLOR="#555555"> </FONT></TD><TD ALIGN="LEFT" BGCOLOR="white">precio_unitario</TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="precio_unitario_r"><FONT POINT-SIZE="9" COLOR="#555555">NUMERIC(15,4)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="tasa_comision_l"><FONT POINT-SIZE="9" COLOR="#555555"> </FONT></TD><TD ALIGN="LEFT" BGCOLOR="white">tasa_comision</TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="tasa_comision_r"><FONT POINT-SIZE="9" COLOR="#555555">NUMERIC(6,4)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="tasa_pactada_l"><FONT POINT-SIZE="9" COLOR="#555555">NULL</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white">tasa_pactada</TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="tasa_pactada_r"><FONT POINT-SIZE="9" COLOR="#555555">NUMERIC(6,4)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="monto_l"><FONT POINT-SIZE="9" COLOR="#555555">GEN</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white">monto</TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="monto_r"><FONT POINT-SIZE="9" COLOR="#555555">NUMERIC(15,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="comision_l"><FONT POINT-SIZE="9" COLOR="#555555">GEN</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white">comision</TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="comision_r"><FONT POINT-SIZE="9" COLOR="#555555">NUMERIC(15,2)</FONT></TD></TR></TABLE>>];
  rendimiento [shape=plain, label=<<TABLE BORDER="2" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#1f3a5f"><TR><TD COLSPAN="3" BGCOLOR="#1f3a5f"><FONT COLOR="white"><B>rendimiento</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fff3cd" PORT="id_rendimiento_l"><FONT POINT-SIZE="9" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#fff3cd"><B>id_rendimiento</B></TD><TD ALIGN="LEFT" BGCOLOR="#fff3cd" PORT="id_rendimiento_r"><FONT POINT-SIZE="9" COLOR="#555555">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e3eef9" PORT="id_cuenta_l"><FONT POINT-SIZE="9" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#e3eef9">id_cuenta</TD><TD ALIGN="LEFT" BGCOLOR="#e3eef9" PORT="id_cuenta_r"><FONT POINT-SIZE="9" COLOR="#555555">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e3eef9" PORT="id_activo_l"><FONT POINT-SIZE="9" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#e3eef9">id_activo</TD><TD ALIGN="LEFT" BGCOLOR="#e3eef9" PORT="id_activo_r"><FONT POINT-SIZE="9" COLOR="#555555">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="fecha_l"><FONT POINT-SIZE="9" COLOR="#555555"> </FONT></TD><TD ALIGN="LEFT" BGCOLOR="white">fecha</TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="fecha_r"><FONT POINT-SIZE="9" COLOR="#555555">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="tipo_rendimiento_l"><FONT POINT-SIZE="9" COLOR="#555555"> </FONT></TD><TD ALIGN="LEFT" BGCOLOR="white">tipo_rendimiento</TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="tipo_rendimiento_r"><FONT POINT-SIZE="9" COLOR="#555555">VARCHAR(10)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="monto_l"><FONT POINT-SIZE="9" COLOR="#555555"> </FONT></TD><TD ALIGN="LEFT" BGCOLOR="white">monto</TD><TD ALIGN="LEFT" BGCOLOR="white" PORT="monto_r"><FONT POINT-SIZE="9" COLOR="#555555">NUMERIC(15,2)</FONT></TD></TR></TABLE>>];
  cliente:id_perfil_l:w -> perfil_riesgo:id_perfil_r:e [arrowhead=normal, arrowtail=crow, dir=both, color="#34495e"];
  cliente:id_asesor_l:w -> asesor:id_asesor_r:e [arrowhead=normal, arrowtail=crow, dir=both, color="#34495e"];
  cuenta:id_cliente_l:w -> cliente:id_cliente_r:e [arrowhead=normal, arrowtail=crow, dir=both, color="#34495e"];
  movimiento_efectivo:id_cuenta_l:w -> cuenta:id_cuenta_r:e [arrowhead=normal, arrowtail=crow, dir=both, color="#34495e"];
  activo:id_tipo_activo_l:w -> tipo_activo:id_tipo_activo_r:e [arrowhead=normal, arrowtail=crow, dir=both, color="#34495e"];
  accion_fondo:id_activo_l:w -> activo:id_activo_r:e [arrowhead=normal, arrowtail=crow, dir=both, color="#34495e"];
  cdt:id_activo_l:w -> activo:id_activo_r:e [arrowhead=normal, arrowtail=crow, dir=both, color="#34495e"];
  tes:id_activo_l:w -> activo:id_activo_r:e [arrowhead=normal, arrowtail=crow, dir=both, color="#34495e"];
  precio_historico:id_activo_l:w -> accion_fondo:id_activo_r:e [arrowhead=normal, arrowtail=crow, dir=both, color="#34495e"];
  transaccion:id_cuenta_l:w -> cuenta:id_cuenta_r:e [arrowhead=normal, arrowtail=crow, dir=both, color="#34495e"];
  transaccion:id_activo_l:w -> activo:id_activo_r:e [arrowhead=normal, arrowtail=crow, dir=both, color="#34495e"];
  rendimiento:id_cuenta_l:w -> cuenta:id_cuenta_r:e [arrowhead=normal, arrowtail=crow, dir=both, color="#34495e"];
  rendimiento:id_activo_l:w -> activo:id_activo_r:e [arrowhead=normal, arrowtail=crow, dir=both, color="#34495e"];
  precio_historico -> trm [style=invis];
}
