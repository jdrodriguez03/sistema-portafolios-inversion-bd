digraph G {
  graph [fontname="Helvetica", bgcolor="white", pad=0.3, nodesep=0.45, ranksep=0.9, splines=true, rankdir=LR, label="Modelo conceptual EER - Sistema de Gestion de Portafolios de Inversion\nNotacion (min,max) junto a cada entidad: cuantas veces participa en la relacion.  Subrayado = identificador.  / = atributo derivado.  Borde doble = entidad debil / relacion identificadora.", labelloc=t, fontsize=13];
  node [fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=10, color="#34495e", arrowhead=none];
  PERFIL_RIESGO [shape=plain, label=<<TABLE BORDER="3" CELLBORDER="1" COLOR="#1f3a5f" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#1f3a5f"><FONT COLOR="white"><B>PERFIL RIESGO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><U><B>id_perfil</B></U></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">nombre_perfil</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">limite_max_renta_var</TD></TR></TABLE>>];
  ASESOR [shape=plain, label=<<TABLE BORDER="3" CELLBORDER="1" COLOR="#1f3a5f" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#1f3a5f"><FONT COLOR="white"><B>ASESOR</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><U><B>id_asesor</B></U></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">documento (tipo, numero)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">nombre (nombres, apellidos)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">email</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">telefono</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">fecha_ingreso</TD></TR></TABLE>>];
  CLIENTE [shape=plain, label=<<TABLE BORDER="3" CELLBORDER="1" COLOR="#1f3a5f" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#1f3a5f"><FONT COLOR="white"><B>CLIENTE</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><U><B>id_cliente</B></U></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">documento (tipo, numero)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">nombre (nombres, apellidos)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">email</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">telefono</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">fecha_nacimiento</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">fecha_vinculacion</TD></TR></TABLE>>];
  CUENTA [shape=plain, label=<<TABLE BORDER="3" CELLBORDER="1" COLOR="#1f3a5f" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#1f3a5f"><FONT COLOR="white"><B>CUENTA</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><U><B>id_cuenta</B></U></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">nombre_cuenta</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">fecha_apertura</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">estado</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><I>/ saldo_efectivo</I></TD></TR></TABLE>>];
  MOVIMIENTO_EFECTIVO [shape=plain, label=<<TABLE BORDER="3" CELLBORDER="1" COLOR="#1f3a5f" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#1f3a5f"><FONT COLOR="white"><B>MOVIMIENTO EFECTIVO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><U><B>id_movimiento</B></U></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">tipo_movimiento</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">fecha_hora</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">monto</TD></TR></TABLE>>];
  TRANSACCION [shape=plain, label=<<TABLE BORDER="3" CELLBORDER="1" COLOR="#1f3a5f" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#1f3a5f"><FONT COLOR="white"><B>TRANSACCION</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><U><B>id_transaccion</B></U></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">tipo_transaccion</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">fecha_hora</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">cantidad</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">precio_unitario</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">tasa_comision</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">tasa_pactada</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><I>/ monto</I></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><I>/ comision</I></TD></TR></TABLE>>];
  RENDIMIENTO [shape=plain, label=<<TABLE BORDER="3" CELLBORDER="1" COLOR="#1f3a5f" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#1f3a5f"><FONT COLOR="white"><B>RENDIMIENTO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><U><B>id_rendimiento</B></U></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">tipo_rendimiento</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">fecha</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">monto</TD></TR></TABLE>>];
  ACTIVO [shape=plain, label=<<TABLE BORDER="3" CELLBORDER="1" COLOR="#1f3a5f" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#1f3a5f"><FONT COLOR="white"><B>ACTIVO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><U><B>id_activo</B></U></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">nombre</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">fecha_registro</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">tipo (discriminador)</TD></TR></TABLE>>];
  ACCION_FONDO [shape=plain, label=<<TABLE BORDER="3" CELLBORDER="1" COLOR="#3d6a8f" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#3d6a8f"><FONT COLOR="white"><B>ACCION FONDO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">ticker</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">mercado</TD></TR></TABLE>>];
  CDT [shape=plain, label=<<TABLE BORDER="3" CELLBORDER="1" COLOR="#3d6a8f" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#3d6a8f"><FONT COLOR="white"><B>CDT</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">entidad_emisora</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">fecha_emision</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">fecha_vencimiento</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><I>/ plazo</I></TD></TR></TABLE>>];
  TES [shape=plain, label=<<TABLE BORDER="3" CELLBORDER="1" COLOR="#3d6a8f" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#3d6a8f"><FONT COLOR="white"><B>TES</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">serie</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">tasa_cupon</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">fecha_emision</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">fecha_vencimiento</TD></TR></TABLE>>];
  PRECIO_HISTORICO [shape=plain, label=<<TABLE BORDER="6" CELLBORDER="1" COLOR="#1f3a5f" STYLE="rounded" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#1f3a5f"><FONT COLOR="white"><B>PRECIO HISTORICO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><U>fecha</U> <FONT POINT-SIZE="9" COLOR="#777777">(clave parcial)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">precio_cierre</TD></TR></TABLE>>];
  TRM [shape=plain, label=<<TABLE BORDER="3" CELLBORDER="1" COLOR="#1f3a5f" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#1f3a5f"><FONT COLOR="white"><B>TRM</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><U><B>fecha_desde</B></U></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">fecha_hasta</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">valor_cop</TD></TR></TABLE>>];
  r_gest [shape=diamond, label="gestiona", style=filled, fillcolor="#f4e4b8", color="#8a6d1f", peripheries=1, fontsize=10, margin="0.02,0.02"];
  r_clas [shape=diamond, label="clasifica", style=filled, fillcolor="#f4e4b8", color="#8a6d1f", peripheries=1, fontsize=10, margin="0.02,0.02"];
  r_posee [shape=diamond, label="posee", style=filled, fillcolor="#f4e4b8", color="#8a6d1f", peripheries=1, fontsize=10, margin="0.02,0.02"];
  r_mov [shape=diamond, label="registra", style=filled, fillcolor="#f4e4b8", color="#8a6d1f", peripheries=1, fontsize=10, margin="0.02,0.02"];
  r_ord [shape=diamond, label="ordena", style=filled, fillcolor="#f4e4b8", color="#8a6d1f", peripheries=1, fontsize=10, margin="0.02,0.02"];
  r_obj [shape=diamond, label="se negocia en", style=filled, fillcolor="#f4e4b8", color="#8a6d1f", peripheries=1, fontsize=10, margin="0.02,0.02"];
  r_rec [shape=diamond, label="recibe", style=filled, fillcolor="#f4e4b8", color="#8a6d1f", peripheries=1, fontsize=10, margin="0.02,0.02"];
  r_gen [shape=diamond, label="genera", style=filled, fillcolor="#f4e4b8", color="#8a6d1f", peripheries=1, fontsize=10, margin="0.02,0.02"];
  r_cot [shape=diamond, label="cotiza", style=filled, fillcolor="#f4e4b8", color="#8a6d1f", peripheries=2, fontsize=10, margin="0.02,0.02"];
  esp [shape=circle, label="d", style=filled, fillcolor="white", color="#1f3a5f", penwidth=2, width=0.35, fixedsize=true, fontsize=12];
  PERFIL_RIESGO -> r_clas [label=" (0,N) "];
  r_clas -> CLIENTE [label=" (1,1) "];
  ASESOR -> r_gest [label=" (0,N) "];
  r_gest -> CLIENTE [label=" (1,1) "];
  CLIENTE -> r_posee [label=" (0,N) "];
  r_posee -> CUENTA [label=" (1,1) "];
  CUENTA -> r_mov [label=" (0,N) "];
  r_mov -> MOVIMIENTO_EFECTIVO [label=" (1,1) "];
  CUENTA -> r_ord [label=" (0,N) "];
  r_ord -> TRANSACCION [label=" (1,1) "];
  CUENTA -> r_rec [label=" (0,N) "];
  r_rec -> RENDIMIENTO [label=" (1,1) "];
  TRANSACCION -> r_obj [label=" (1,1) "];
  r_obj -> ACTIVO [label=" (0,N) "];
  RENDIMIENTO -> r_gen [label=" (1,1) "];
  r_gen -> ACTIVO [label=" (0,N) "];
  ACTIVO -> esp [label=" total ", color="#1f3a5f:white:#1f3a5f", penwidth=1.5];
  esp -> ACCION_FONDO [arrowhead=icurve, color="#1f3a5f", penwidth=1.5];
  esp -> CDT [arrowhead=icurve, color="#1f3a5f", penwidth=1.5];
  esp -> TES [arrowhead=icurve, color="#1f3a5f", penwidth=1.5];
  ACCION_FONDO -> r_cot [label=" (0,N) "];
  r_cot -> PRECIO_HISTORICO [label=" (1,1) ", color="#34495e:white:#34495e"];
  nota [shape=note, style=filled, fillcolor="#fdf6e3", color="#b58900", fontsize=10, label="TRM es una entidad de referencia: no se relaciona\npor identificador sino por fecha. La TRM vigente en la\nfecha de una operacion convierte CDT y TES (COP) a USD."];
  TRM -> nota [style=dashed, color="#b58900"];
  { rank=same; TRM; nota; }
  PRECIO_HISTORICO -> TRM [style=invis];
}
